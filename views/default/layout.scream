<!doctype html>
<html lang="{{lang}}">
    <head>
        <meta charset="UTF-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link rel="icon" href="{{ assetUrls.favicon }}">
		<title>{% block title %}ScreamJS{% endblock title %}</title>

		<link rel="stylesheet" href="{{ assetUrls.mainStyles }}">
		<script type="module" src="{{ assetUrls.viteClient }}"></script>
		<script type="module" src="{{ assetUrls.mainScript }}"></script>
    </head>
    <body class="app-shell">
        <header class="app-header">
            <div class="container py-3 d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <a href="{{ homeUrl }}" class="app-brand">ScreamJS Todo</a>
                <nav class="app-nav d-flex flex-wrap gap-3">
                    <a href="{{ todosUrl }}">Todos</a>
                    <a href="{{ tagsUrl }}">Tags</a>
                    <a href="{{ notesUrl }}">Notes</a>
                </nav>
            </div>
        </header>

        <main class="app-main">
            {% block content %}{% endblock content %}
        </main>

        <footer class="app-footer">
            <div class="container py-3 text-center text-muted small">
                Built with ScreamJS
            </div>
        </footer>
    </body>
</html>
