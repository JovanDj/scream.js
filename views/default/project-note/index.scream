{% extends "layout.scream" %}

{% block title %}Project Notes{% endblock title %}

{% block content %}
<div class="container py-4 px-3 mx-auto">
    <section class="page-shell">
        <div class="page-head flex-wrap gap-2">
            <h1 class="page-title">Project Notes</h1>
            <a class="btn btn-primary" href="{{ createUrl }}">Add Note</a>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            {% if isFiltered %}<a href="{{ notesUrl }}">All Notes</a>{% endif %}
            <a href="{{ projectUrl }}">{% if isFiltered %}Back to Project{% else %}Projects{% endif %}</a>
        </div>
        {% if length(notes) %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Title</th><th>Project</th><th>Actions</th></tr></thead>
                <tbody>
                    {% apply notes %}
                    <tr>
                        <td><a href="{{ attr.showUrl }}">{{ attr.title }}</a></td>
                        <td><a href="{{ attr.projectUrl }}">{{ attr.projectName }}</a></td>
                        <td><a class="btn btn-sm btn-outline-primary" href="{{ attr.editUrl }}">Edit</a></td>
                    </tr>
                    {% endapply %}
                </tbody>
            </table>
        </div>
        {% else %}<p class="muted mb-0">No notes yet.</p>{% endif %}
        <nav class="d-flex justify-content-between mt-3" aria-label="Project note pages">
            {% include "shared/pagination-links.scream" with pagination: pagination %}
        </nav>
    </section>
</div>
{% endblock content %}
