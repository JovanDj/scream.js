{% extends "layout.scream" %}

{% block title %}New Todo{% endblock title %}

{% block content %}
    <div class="container py-4 px-3 mx-auto">
        <section class="page-shell">
            <h1 class="page-title mb-3">New Todo</h1>

            <form action="{{ todosUrl }}" method="POST">
                {% include "todo/fields/title.scream" with value: fields.title, error: errors.title %}
                {% include "todo/fields/due-at.scream" with value: fields.dueAt, error: errors.dueAt %}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="{{ todosUrl }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </section>
    </div>
{% endblock content %}
