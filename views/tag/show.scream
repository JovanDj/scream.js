{% extends "layout.scream" %}

{% block title %}Tag | {{ tag.name }}{% endblock title %}

{% block content %}
<div class="container py-4 px-3 mx-auto">
    <section class="page-shell">
        <h1 class="page-title mb-3">{{ tag.name }}</h1>
        <a href="{{ tagsUrl }}">Back to Tags</a>
    </section>
</div>
{% endblock content %}
