{% extends "layout.scream" %}

{% block content %}
<div class="container py-4 px-3 mx-auto">
    <section class="page-shell">
        <h1 class="page-title mb-3">{{ pageTitle }}</h1>
        <form action="{{ action }}" method="POST">
            {% if isEditing %}
            <input type="hidden" name="_method" value="PATCH">
            <p>Project: {{ projectName }}</p>
            {% else %}
            {% if cannotSubmit %}<p>Create a <a href="/projects">project</a> before adding a note.</p>{% endif %}
            <div class="mb-3">
                <label class="form-label" for="projectId">Project</label>
                <select class="form-select" id="projectId" name="projectId" required aria-describedby="projectId-error">
                    <option value="">Select a project</option>
                    {% for project in projects %}
                    <option value="{{ project.id }}" {% attr selected if project.isSelected %}>{{ project.name }}</option>
                    {% endfor %}
                </select>
                {% if errors.projectId %}<div class="invalid-feedback d-block" id="projectId-error">{{ errors.projectId }}</div>{% endif %}
            </div>
            {% endif %}
            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input class="form-control" id="title" name="title" type="text" maxlength="255" required value="{{ fields.title }}" aria-describedby="title-error">
                {% if errors.title %}<div class="invalid-feedback d-block" id="title-error">{{ errors.title }}</div>{% endif %}
            </div>
            <div class="mb-3">
                <label class="form-label" for="body">Body</label>
                <textarea class="form-control" id="body" name="body" rows="10" required aria-describedby="body-error">
{{ fields.body }}</textarea>
                {% if errors.body %}<div class="invalid-feedback d-block" id="body-error">{{ errors.body }}</div>{% endif %}
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit" {% attr disabled if cannotSubmit %}>{{ submitLabel }}</button>
                <a class="btn btn-outline-secondary" href="{{ backUrl }}">Cancel</a>
            </div>
        </form>
        {% if isEditing %}
        <form class="mt-3" action="/project-notes/{{ noteId }}" method="POST">
            <input type="hidden" name="_method" value="DELETE">
            <button class="btn btn-danger" type="submit">Delete</button>
        </form>
        {% endif %}
    </section>
</div>
{% endblock content %}
