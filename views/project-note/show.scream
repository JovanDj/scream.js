{% extends "layout.scream" %}

{% block content %}
<div class="container py-4 px-3 mx-auto">
    <section class="page-shell">
        <h1 class="page-title mb-3">{{ note.title }}</h1>
        <p>Project: <a href="/projects/{{ note.projectId }}">{{ note.projectName }}</a></p>
        <div class="project-note-body mb-4">{{ note.body }}</div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/project-notes?projectId={{ note.projectId }}">Back to Notes</a>
            <a class="btn btn-primary" href="/project-notes/{{ note.id }}/edit">Edit</a>
            <form action="/project-notes/{{ note.id }}" method="POST">
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-danger" type="submit">Delete</button>
            </form>
        </div>
    </section>
</div>
{% endblock content %}
