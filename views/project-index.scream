{% extends "layout.scream" %}

{% block content %}
<div class="container py-4 px-3 mx-auto">
    <section class="page-shell">
        <div class="page-head">
            <h1 class="page-title">Projects</h1>
        </div>

        <form method="GET" action="/projects" class="mb-3">
			<input type="hidden" name="direction" value="{{ direction }}">
			<input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="status" value="{{ status }}">
            <div class="row g-2">
                <div class="col-8">
                    <input class="form-control" name="search" placeholder="Search projects" value="{{ search }}" type="text">
                </div>
                <div class="col-4">
                    <button class="btn btn-outline-primary w-100" type="submit">Search</button>
                </div>
            </div>
        </form>

        <div class="d-flex flex-wrap gap-2 mb-3">
			<a class="btn btn-sm btn-outline-secondary" href="{{ sorts.created }}">Newest</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ filters.all }}">All</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ filters.active }}">Active</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ filters.archived }}">Archived</a>
        </div>

        {% if projects.length %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th><a href="{{ sorts.name }}">Name</a></th>
                        <th><a href="{{ sorts.status }}">Status</a></th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                    <tr>
                        <td><a href="/projects/{{ project.id }}">{{ project.name }}</a></td>
                        <td>{{ project.statusCode }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="muted mb-0">No projects yet.</p>
        {% endif %}

		<nav class="d-flex justify-content-between mt-3" aria-label="Project pages">
			{% if pagination.previousUrl %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.previousUrl }}">Previous</a>{% else %}<span></span>{% endif %}
			{% if pagination.nextUrl %}<a class="btn btn-sm btn-outline-secondary" href="{{ pagination.nextUrl }}">Next</a>{% endif %}
		</nav>
    </section>
</div>
{% endblock content %}
