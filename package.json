	},
	"engines": {
		"node": "^26"
	},
	"exports": {
		"./cli": "./dist/lib/cli/index.js",
		"./dist/lib/*": "./dist/lib/*"
	},
	"files": [
		"/dist/lib"
	],
	"keywords": [],
	"license": "MIT",
	"lint-staged": {
		".ts": [
			"tsc --noEmit",
			"biome check --write --no-errors-on-unmatched",
			"npm test"
		],
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
	"main": "dist/index.js",
	"name": "scream.js",
	"overrides": {
		"cheerio": {
			"encoding-sniffer": "1.0.2"
		}
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"check": "run-p typecheck lint:fix test",
		"db:migrate": "npm run scream -- db:migrate",
		"db:reset": "npm run scream -- db:reset --force",
		"db:seed": "npm run scream -- db:seed",
		"dev": "run-p start vite",
		"dev:compact": "cross-env SCREAM_SKIN=compact npm run dev",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prepare": "husky",
		"scream": "tsx app-cli.ts",
		"start": "tsx --watch server.ts",
		"start:compact": "cross-env SCREAM_SKIN=compact npm run start",
		"test": "cross-env NODE_ENV=test run-p test:integration test:e2e",
		"test:e2e": "cross-env NODE_ENV=e2e playwright test",
		"test:integration": "cross-env NODE_ENV=integration tsx --test \"lib/**/*.test.ts\" \"src/**/*.test.ts\" \"*.test.ts\"",
		"typecheck": "npm run typecheck:server && npm run typecheck:browser",
		"typecheck:browser": "tsc --noEmit -p resources/tsconfig.json",
		"typecheck:server": "tsc --noEmit",
		"typecheck:watch": "run-p \"typecheck:server -- --watch\" \"typecheck:browser -- --watch\"",
		"vite": "vite"
	},
	"type": "module",
	"types": "dist/index.d.ts",
	"version": "0.1.0",
	"volta": {
		"node": "26.13.0"
	}
}
