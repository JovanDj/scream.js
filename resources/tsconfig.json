{
	"compilerOptions": {
		"erasableSyntaxOnly": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"target": "ES2024",
		"types": ["vite/client"],
		"verbatimModuleSyntax": true
	},
	"extends": [
		"@tsconfig/recommended/tsconfig.json",
		"@tsconfig/strictest/tsconfig.json"
	],
	"include": ["./**/*.ts"]
}
